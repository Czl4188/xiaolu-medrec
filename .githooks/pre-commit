#!/bin/sh
# 提交前拦截：本地配置、密钥、数据库、构建产物，以及疑似 API Key。
# 启用：git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
  exit 0
fi

bad=$(printf '%s\n' "$staged" | grep -Ei '(^|/)\.env$|(^|/)config\.env$|\.key$|\.pem$|\.db$|(^|/)data/|(^|/)dist/|(^|/)\.venv/')
if [ -n "$bad" ]; then
  echo "提交被拒绝：以下文件不应进入仓库" >&2
  printf '%s\n' "$bad" >&2
  echo "请先 git restore --staged <文件>，并确认 .gitignore 已覆盖。" >&2
  exit 1
fi

if git diff --cached -U0 | grep -E 'sk-[A-Za-z0-9_-]{20,}' >/dev/null 2>&1; then
  echo "提交被拒绝：暂存内容里疑似包含 API Key。" >&2
  echo "请把 Key 放到服务端 config.env，或改用占位符。" >&2
  exit 1
fi

exit 0
