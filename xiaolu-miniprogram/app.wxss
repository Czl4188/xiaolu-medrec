page {
    background: #faf9f5;
    color: #1b1b19;
    font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
    font-size: 28rpx;
    line-height: 1.6;
}

.page {
    min-height: 100vh;
    padding: 32rpx 32rpx 48rpx;
    box-sizing: border-box;
}

.card {
    background: #ffffff;
    border: 1rpx solid rgba(27, 27, 25, 0.12);
    border-radius: 20rpx;
    padding: 28rpx;
}

.muted {
    color: #8b8a82;
    font-size: 24rpx;
}

.btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 92rpx;
    border-radius: 16rpx;
    font-size: 30rpx;
    font-weight: 600;
    border: none;
    margin: 0;
}

.btn::after {
    border: none;
}

.btn--primary {
    background: #0f6e63;
    color: #ffffff;
}

.btn--ghost {
    background: #ffffff;
    color: #0f6e63;
    border: 1rpx solid rgba(15, 110, 99, 0.4);
}

.btn[disabled] {
    opacity: 0.55;
}

.field {
    margin-bottom: 24rpx;
}

.field__k {
    display: block;
    font-size: 24rpx;
    color: #6b6a63;
    margin-bottom: 10rpx;
}

.field__in {
    height: 92rpx;
    background: #ffffff;
    border: 1rpx solid rgba(27, 27, 25, 0.18);
    border-radius: 14rpx;
    padding: 0 24rpx;
    font-size: 30rpx;
    box-sizing: border-box;
}

.form-error {
    color: #b3261e;
    font-size: 24rpx;
    margin: 8rpx 0 16rpx;
    min-height: 34rpx;
}

.empty,
.state {
    padding: 96rpx 24rpx;
    text-align: center;
    color: #8b8a82;
    font-size: 26rpx;
}
