.state__btn {
    margin-top: 32rpx;
}

.list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.item {
    background: #ffffff;
    border: 1rpx solid rgba(27, 27, 25, 0.12);
    border-left: 6rpx solid #0f6e63;
    border-radius: 18rpx;
    padding: 24rpx;
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.item__hd {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.item__date {
    font-size: 24rpx;
    color: #8b8a82;
}

.item__badge {
    font-size: 22rpx;
    color: #0f6e63;
    background: rgba(15, 110, 99, 0.1);
    border-radius: 999rpx;
    padding: 4rpx 16rpx;
}

.item__hosp {
    font-size: 32rpx;
    font-weight: 600;
}

.item__sum {
    font-size: 28rpx;
    color: #3d3c37;
}

.item__meds {
    font-size: 24rpx;
    color: #6b6a63;
}
