.login {
    display: flex;
    flex-direction: column;
    padding-top: 56rpx;
}

.login__deer {
    width: 168rpx;
    height: 168rpx;
    border-radius: 40rpx;
    align-self: center;
}

.login__title {
    margin: 20rpx 0 44rpx;
    text-align: center;
    font-size: 44rpx;
    font-weight: 700;
}

.tabs {
    display: flex;
    background: #ffffff;
    border: 1rpx solid rgba(27, 27, 25, 0.12);
    border-radius: 14rpx;
    padding: 6rpx;
    margin-bottom: 32rpx;
}

.tabs__item {
    flex: 1;
    text-align: center;
    padding: 18rpx 0;
    font-size: 28rpx;
    color: #6b6a63;
    border-radius: 10rpx;
}

.tabs__item.is-on {
    background: #0f6e63;
    color: #ffffff;
    font-weight: 600;
}

.login__help {
    margin-top: 32rpx;
    text-align: center;
    font-size: 24rpx;
    color: #0f6e63;
}
