# —— 基础 ——
APP_ENV=dev
APP_NAME=xiaolu-medrec-api
DEBUG=false

# —— 安全（生产必须换掉，生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"）——
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_TTL_SECONDS=604800
# 只有确实跨域时才需要写；同端口托管前端时留空即可
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_REQUEST_MB=2
MAX_UPLOAD_MB=25

# —— 数据库 ——
# 本地：sqlite:///./data/app.db
# 生产：postgresql+psycopg://medrec:密码@postgres:5432/medrec
DATABASE_URL=sqlite:///./data/app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# —— 缓存/限流（多实例必填，否则限流只在单进程内生效）——
REDIS_URL=

# —— 限流 ——
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=12

# —— 模型 ——
# none 表示不接模型：接口照常可用，回答走规则式文案
LLM_PROVIDER=none
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN=30

# —— 语音转写 ——
# none 时 /api/asr 返回 501，前端继续用浏览器识别
ASR_PROVIDER=none
ASR_MODEL=whisper-1

# —— Worker ——
WORKER_ID=
JOB_POLL_INTERVAL=1.0
JOB_MAX_ATTEMPTS=5

# —— 静态前端（可选：同一端口顺带托管 app.html）——
# FRONTEND_DIR=../xiaoxiao-ai
